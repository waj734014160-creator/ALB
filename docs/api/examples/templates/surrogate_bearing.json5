{
  schema_version: "0.4.0",
  kind: "bearing",
  includes: [],
  spec: {
    family: "surrogate",
    unit_system: "dimensional",
    time_step: 1e-4,
    node: null,
    model_package: {
      // Replace with a validated package created by create_model_package().
      path: "models/albnn_package",
      use_augment: false,
      // null follows metadata inference_symmetry; use "c4" for packages
      // trained only on ex, ey >= 0 (for example M35/M42).
