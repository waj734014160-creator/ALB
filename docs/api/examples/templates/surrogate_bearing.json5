      // null uses 0.15 (15% of a quadrant = 13.5 deg half-width); 0 preserves the plain mapping.
      c4_blend_ratio: null,
    },
    runtime: {
      parameters: {
        clearance: 8e-5,
        radius: 0.04,
      },
      spool_mode: "fixed",
      spool: [0.0, 0.0],
    },
  },
}
